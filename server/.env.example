# ==============================================================================
# SkillSwap Backend Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Never commit real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & SERVER
# ------------------------------------------------------------------------------
# Runtime Environment: development | production | test
NODE_ENV=development

# Server Port (default: 5000)
PORT=5000

# PostgreSQL Connection String (Prisma v8 RC contract-driven runtime)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillswap?schema=public"

# Allowed Client Origin for CORS and Socket.IO Handshake
CLIENT_URL="http://localhost:5173"

# Structured Logging Level: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Required in production: >= 32 characters)
# ------------------------------------------------------------------------------
JWT_SECRET="skillswap-dev-jwt-super-secret-key-32chars-min"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="skillswap-dev-cookie-secret-key-32chars"

# Initial Platform Administrator Seed Password (optional)
INITIAL_ADMIN_PASSWORD="AdminPass123!"

# ------------------------------------------------------------------------------
# 3. WEB PUSH NOTIFICATIONS (RFC 8292 VAPID)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY="BEMJEc0SSeD7V7hSKwinFmepDVt_BTMoWnleMePjKvIm03PK6Cx7o5WQ1mOLwcj3sAVDVK7SRL3rppxJufQd4Kg"
VAPID_PRIVATE_KEY="8spk2LJw67tg2noKEZPxwgo2VYVmPJwfBTALO1a0Crg"
VAPID_SUBJECT="mailto:admin@skillswap.local"

# ------------------------------------------------------------------------------
# 4. OPTIONAL: JITSI MEET VIDEO INTEGRATION
# ------------------------------------------------------------------------------
JITSI_APP_ID="skillswap-dev"
JITSI_DOMAIN="meet.jit.si"

# ------------------------------------------------------------------------------
# 5. OPTIONAL: AI ENGINE PROVIDER (deterministic | gemini)
# ------------------------------------------------------------------------------
AI_PROVIDER="deterministic"
# GEMINI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------------------------
# 6. OPTIONAL: SAAS MONETIZATION & STRIPE (MOCK | STRIPE)
# ------------------------------------------------------------------------------
BILLING_PROVIDER="MOCK"
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------------------------
# 7. OPTIONAL: TRANSACTIONAL EMAIL / SMTP
# ------------------------------------------------------------------------------
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="your-smtp-username"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="SkillSwap <no-reply@skillswap.local>"
