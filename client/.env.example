# ==============================================================================
# SkillSwap Frontend Environment Configuration Template
# In development, Vite automatically proxies /api and /socket.io to http://localhost:5000.
# If deploying client to an independent domain without reverse proxying, configure:
# ==============================================================================

# API Base URL (defaults to /api when empty or omitted for same-origin reverse proxy)
VITE_API_URL="/api"

# Socket.IO Gateway URL (defaults to window.location.origin when empty)
VITE_SOCKET_URL=""

